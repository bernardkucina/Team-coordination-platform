// tasks service: projects, workstreams, tasks and the task history.

model Project {
  id          String   @id
  name        String
  description String   @default("")
  leadId      String?
  lead        Member?  @relation("ProjectLead", fields: [leadId], references: [id], onDelete: SetNull)
  deadline    DateTime? @db.Date
  /// "01" … "07" as in the projects document; empty for projects added later.
  number      String   @default("")
  status      ProjectStatus @default(active)
  /// An AreaId from @hub-pulse/shared (AREAS).
  mainArea    String   @default("strategy")
  tags        String[] @default([])
  /// One line for the overview card; empty = use the description.
  tagline     String   @default("")
  /// [{ name, description }]: the roles people can take in the project.
  roles       Json     @default("[]")
  createdAt   DateTime @default(now())

  members     ProjectMember[]
  interested  ProjectInterest[]
  workstreams Workstream[]
  tasks       Task[]
  timeEntries TimeEntry[]
  series      MeetingSeries[]
  timers      ActiveTimer[]
}

enum ProjectStatus {
  active
  planned
}

/// The project team (Join / Leave).
model ProjectMember {
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  memberId  String
  member    Member  @relation(fields: [memberId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([projectId, memberId])
  @@index([memberId])
}

/// "I'm interested" in a planned project.
model ProjectInterest {
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  memberId  String
  member    Member  @relation(fields: [memberId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([projectId, memberId])
}

model Workstream {
  id          Int     @id @default(autoincrement())
  projectId   String
  project     Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name        String
  color       String
  leadId      String?
  lead        Member? @relation("WorkstreamLead", fields: [leadId], references: [id], onDelete: SetNull)
  /// Tasks finished before the platform existed (from the old Miro board).
  doneEarlier Int     @default(0)
  position    Int

  @@unique([projectId, name])
}

enum TaskStatus {
  idea
  priority
  progress
  validation
  done
}

enum Priority {
  High
  Medium
  Low
}

model Task {
  id          Int        @id @default(autoincrement())
  projectId   String
  project     Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /// Name of a workstream in the same project.
  workstream  String
  title       String
  status      TaskStatus @default(priority)
  ownerId     String?
  owner       Member?    @relation("TaskOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  createdById String?
  createdBy   Member?    @relation("TaskCreator", fields: [createdById], references: [id], onDelete: SetNull)
  priority    Priority   @default(Medium)
  startWeek   Int?
  endWeek     Int?
  due         DateTime?  @db.Date
  notes       String     @default("")
  /// When the task was last moved to done; cleared when it leaves done.
  doneAt      DateTime?
  /// Position in the project's to-do list once someone reordered it; null = by id.
  rank        Int?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  helpers TaskHelper[]
  links   TaskLink[]
  events  TaskEvent[]

  @@index([projectId])
  @@index([ownerId])
}

model TaskHelper {
  taskId   Int
  task     Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  memberId String
  member   Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@id([taskId, memberId])
}

model TaskLink {
  id       Int    @id @default(autoincrement())
  taskId   Int
  task     Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  label    String
  url      String
  position Int
}

enum TaskEventKind {
  created
  updated
  /// A member made themselves owner of a task nobody owned.
  picked
  comment
}

model TaskEvent {
  id        Int           @id @default(autoincrement())
  taskId    Int
  task      Task          @relation(fields: [taskId], references: [id], onDelete: Cascade)
  actorId   String?
  actor     Member?       @relation(fields: [actorId], references: [id], onDelete: SetNull)
  kind      TaskEventKind
  text      String
  comment   String?
  createdAt DateTime      @default(now())

  @@index([taskId, createdAt])
  @@index([actorId, createdAt])
}
