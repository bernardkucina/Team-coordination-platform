// members service: people, tiers, roles and login sessions.

enum Tier {
  GO
  IMPACT
  CORE
}

model Member {
  id       String    @id
  email    String    @unique
  name     String
  tier     Tier
  isAdmin  Boolean   @default(false)
  active   Boolean   @default(true)
  joinedOn DateTime? @db.Date
  /// Email of the member's Slack account (the roster emails are not real). Set by the super admin.
  slackEmail  String?
  /// Found with users.lookupByEmail and cached.
  slackUserId String?
  createdAt DateTime @default(now())

  sessions Session[]
  areas    MemberArea[]

  // Back-relations from the other services' models.
  projectsLed    Project[]          @relation("ProjectLead")
  workstreamsLed Workstream[]       @relation("WorkstreamLead")
  ownedTasks     Task[]             @relation("TaskOwner")
  createdTasks   Task[]             @relation("TaskCreator")
  helping        TaskHelper[]
  taskEvents     TaskEvent[]
  timeEntries    TimeEntry[]
  timers         ActiveTimer[]
  series         SeriesMember[]
  attendance     AttendanceRecord[]
  slackMessages  SlackMessage[]
  projects       ProjectMember[]
  interests      ProjectInterest[]
}

/// Areas (oddelki) a member joined directly. areaId is an AreaId from @hub-pulse/shared.
model MemberArea {
  memberId  String
  member    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  areaId    String
  createdAt DateTime @default(now())

  @@id([memberId, areaId])
}

/// Public internet addresses of the Impact Hub wifi. Only from these can members log time "in the hub".
/// Saved by the super admin (plus HUB_IPS); with none saved, the check is off.
model HubAddress {
  ip        String   @id
  label     String   @default("")
  createdAt DateTime @default(now())
}

/// A signed-in browser: either a member, or the super admin (who is not a member and only manages access).
model Session {
  id         String   @id
  memberId   String?
  member     Member?  @relation(fields: [memberId], references: [id], onDelete: Cascade)
  superAdmin Boolean  @default(false)
  createdAt  DateTime @default(now())
  expiresAt DateTime

  @@index([memberId])
}
