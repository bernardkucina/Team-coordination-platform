// meetings service: the six meeting series and their meetings, read from the calendar (never written back).

model MeetingSeries {
  id        String   @id
  name      String
  /// null = hub-wide.
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  members  SeriesMember[]
  meetings Meeting[]
}

model SeriesMember {
  seriesId String
  series   MeetingSeries @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  memberId String
  member   Member        @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@id([seriesId, memberId])
}

model Meeting {
  /// The calendar event UID without its domain, e.g. "community-20260914".
  id       String        @id
  uid      String        @unique
  seriesId String
  series   MeetingSeries @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  title    String
  location String        @default("")
  startsAt DateTime
  endsAt   DateTime
  /// An admin confirmed the attendance list; members without a record then count as missed.
  recorded Boolean       @default(false)

  attendance AttendanceRecord[]
  timers     ActiveTimer[]

  @@index([startsAt])
}
