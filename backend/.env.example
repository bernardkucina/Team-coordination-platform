# Copy to .env for local development.
DATABASE_URL="postgresql://hub:hub@localhost:5432/hub_pulse"
# Used for migrations. Locally the same as DATABASE_URL. On Supabase (Vercel):
#   DATABASE_URL = transaction pooler, port 6543, ending in ?pgbouncer=true&connection_limit=1
#   DIRECT_URL   = session pooler, port 5432
DIRECT_URL="postgresql://hub:hub@localhost:5432/hub_pulse"
PORT=4000

# Enables the sandbox login picker (/api/auth/demo-users, /api/auth/demo-login). Turn off for real use.
DEMO_MODE=true

# Optional: start the server clock at this Europe/Ljubljana time (it keeps running from there),
# Leave empty to use the real time. Example: "2026-10-26T17:55" opens clock-in for the
# Monday 26 Oct 18:00 meeting (the sandbox has no meetings on weekends).
DEMO_NOW=

# Set to true in production (HTTPS) so the session cookie is only sent over TLS.
COOKIE_SECURE=false

# The super admin is made up (not a member, not in the database) and only manages access: who can sign in
# and who is an admin. It signs in on the normal form with this email and password. No password = no super admin.
SUPER_ADMIN_EMAIL="super.admin@hub-pulse.app"
SUPER_ADMIN_PASSWORD=

# The calendar's public iCal address (Google Calendar: Settings › your calendar › "Public address in iCal format").
# Read only. Synced on "Sync now" and when the last sync is older than CALENDAR_SYNC_MINUTES (default 15).
CALENDAR_ICS_URL=

# Slack extras (optional). Create the app from slack-app-manifest.json, install it, then copy:
#   Bot User OAuth Token (OAuth & Permissions) and Signing Secret (Basic Information).
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
# Vercel Cron calls GET /api/cron/daily with "Authorization: Bearer <CRON_SECRET>" (calendar sync, meeting
# messages, daily summary, monthly report on the 1st).
CRON_SECRET=
# Links in Slack messages (on Vercel it defaults to the production URL).
PUBLIC_APP_URL=http://localhost:3000

# Serve the built frontend (npm run build -w frontend) from the backend process: one app on one port.
SERVE_FRONTEND=false
