# Copy to .env for local development.
DATABASE_URL="postgresql://hub:hub@localhost:5432/hub_pulse"
PORT=4000

# Enables the sandbox login picker (/api/auth/demo-users, /api/auth/demo-login). Turn off for real use.
DEMO_MODE=true

# Optional: start the server clock at this Europe/Ljubljana time (it keeps running from there),
# Leave empty to use the real time. Example: "2026-10-26T17:55" opens clock-in for the
# Monday 26 Oct 18:00 meeting (the sandbox has no meetings on weekends).
DEMO_NOW=

# Set to true in production (HTTPS) so the session cookie is only sent over TLS.
COOKIE_SECURE=false
